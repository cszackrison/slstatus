#!/bin/sh

# Fetch OpenCode Go usage from the public API and cache percentages and resets.

set -u

cache_base=${XDG_CACHE_HOME:-"${HOME}/.cache"}
config_base=${XDG_CONFIG_HOME:-"${HOME}/.config"}
cache_dir=$cache_base/slstatus
cache_file=$cache_dir/opencode-go-usage-v1
config_file=$config_base/slstatus/opencode-go.json
response_tmp=
response_owned=0
header_tmp=
output_tmp=

cleanup()
{
	[ "$response_owned" -eq 1 ] && [ -n "$response_tmp" ] &&
		rm -f "$response_tmp"
	[ -n "$header_tmp" ] && rm -f "$header_tmp"
	[ -n "$output_tmp" ] && rm -f "$output_tmp"
}

fail()
{
	if [ "${SLSTATUS_OPENCODE_DEBUG:-0}" = "1" ]; then
		printf 'opencode-go-usage-cache: %s\n' "${1:-unknown failure}" >&2
	fi
	rm -f "$cache_file"
	exit 1
}

trap cleanup 0
trap 'exit 1' HUP INT TERM

umask 077
mkdir -p "$cache_dir" || fail "cannot create cache directory"
chmod 700 "$cache_dir" || fail "cannot protect cache directory"

if [ "${1:-}" = "--parse" ]; then
	[ "$#" -eq 2 ] && [ -r "$2" ] || fail "cannot read API response"
	response_tmp=$2
else
	[ "$#" -eq 0 ] || fail "invalid arguments"
	api_key=${OPENCODE_API_KEY:-}
	if [ -z "$api_key" ]; then
		[ -r "$config_file" ] || fail "OpenCode API key is not configured"
		if find "$config_file" -prune -perm /077 -print -quit 2>/dev/null \
			| grep -q .; then
			fail "configuration permissions are not 600"
		fi
		api_key=$(jq -er \
			'.apiKey | strings |
			 select(length > 0 and all(explode[]; . >= 33 and . <= 126))' \
			"$config_file" 2>/dev/null) || fail "invalid API key"
	else
		jq -en --arg key "$api_key" \
			'$key | select(length > 0 and
			 all(explode[]; . >= 33 and . <= 126))' \
			>/dev/null || fail "invalid API key"
	fi

	response_tmp=$(mktemp "$cache_dir/.opencode-go-response.XXXXXX") ||
		fail "cannot create response file"
	response_owned=1
	header_tmp=$(mktemp "$cache_dir/.opencode-go-header.XXXXXX") ||
		fail "cannot create header file"
	printf 'Authorization: Bearer %s\n' "$api_key" > "$header_tmp" ||
		fail "cannot create request header"
	api_key=
	if ! curl --silent --show-error --fail --location --compressed \
		--connect-timeout 3 --max-time 10 \
		--header 'Accept: application/json' --header "@$header_tmp" \
		--output "$response_tmp" \
		'https://opencode.ai/zen/go/v1/usage'; then
		fail "API request failed"
	fi
fi

values=$(jq -er '
	def window($name):
		.usage[$name] as $window |
		if ($window | type) == "object" and
		   ($window.percent | type) == "number" and
		   $window.percent >= 0 and $window.percent <= 100 and
		   ($window.resetsAt | type) == "string" and
		   ($window.resetsAt | length) > 0
		then [$window.percent, $window.resetsAt]
		else ["-", "-"]
		end;
	[window("rolling"), window("weekly"), window("monthly")] |
	map(.[]) | @tsv
' "$response_tmp" 2>/dev/null) || fail "invalid API response"

tab=$(printf '\t')
old_ifs=$IFS
IFS=$tab
read -r five_used five_reset week_used week_reset month_used month_reset <<EOF
$values
EOF
IFS=$old_ifs

parse_reset()
{
	if [ "$1" = "-" ]; then
		printf '%s\n' '-'
		return
	fi
	date -d "$1" +%s 2>/dev/null
}

five_reset=$(parse_reset "$five_reset") || fail "invalid reset time"
week_reset=$(parse_reset "$week_reset") || fail "invalid reset time"
month_reset=$(parse_reset "$month_reset") || fail "invalid reset time"

if [ "$five_used" = "-" ] && [ "$week_used" = "-" ] && \
	[ "$month_used" = "-" ]; then
	fail "API response has no usage data"
fi

output_tmp=$(mktemp "$cache_dir/.opencode-go-usage.XXXXXX") ||
	fail "cannot create cache file"
printf 'v1\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
	"$(date +%s)" "$five_used" "$five_reset" "$week_used" \
	"$week_reset" "$month_used" "$month_reset" > "$output_tmp" ||
	fail "cannot write cache file"
mv -f "$output_tmp" "$cache_file" || fail "cannot publish cache file"
output_tmp=
